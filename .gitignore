# Виртуальные окружения и сборка
.venv/
venv/
build/
dist/
*.egg-info/

# Python-кеши и артефакты инструментов
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Локальные настройки и редакторы
*.swp
.idea/
.vscode/

# Сборка пакетов (packaging/aur): makepkg кладёт сюда исходники и пакеты
packaging/aur/**/pkg/
packaging/aur/**/src/
packaging/aur/**/*.pkg.tar.*
# Клон git-источника для mousecfg-git (имя совпадает с pkgname)
packaging/aur/mousecfg-git/mousecfg-git/
